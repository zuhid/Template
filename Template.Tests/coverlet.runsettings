<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Include>[Zuhid.Template]*</Include>
					<Exclude>[Zuhid.Template]*TemplateContext,[Zuhid.Template]*Migrations.*,[Zuhid.Template]*AppSetting,[Zuhid.Template]*Program</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
